# Rust
/target/
/target-lane-*/
**/*.rs.bk
Cargo.lock.bak

# Local build/test artifacts (never stage; the eval harness owns target/)
/target-alt/
/target-exp-*/
/target-release-*/
/target-perf-*/
/target-build2/
/target-perf2/
/target-gnu/
/target-gnu-off/
/target-linux/
/target-merge/
/target-ab-*/
/target-ci-fix/
/scripts/tui_conpty/out/
/.pi/
/AGENT.md

# Environment / credentials
.env
.env.*
!.env.example
*.pem
*.key
**/auth.json

# Logs
*.log
logs/
pi.log

# Sessions / data
sessions/
*.db
*.db-shm
*.db-wal

# Node (forbidden artifacts that must never appear in the pure-Rust repo)
node_modules/
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml
*.ts
*.tsx
*.js
# Standalone pi-phone PWA client source (served/embedded by the central server).
!clients/pi-phone-pwa/**

# OS
.DS_Store
Thumbs.db
# Process evidence / local audit artifacts (never push)
/.audit/
**/__pycache__/
*.pyc

# Multi-lane play evidence: protocol, issues, lane journals and the measured
# reports live here. It is working material, not shipped source, and it holds
# large regenerable artifacts (pinned binaries, session JSONL, CSVs), so it
# never enters the repository.
/.play/

# cm-memory tool cache (binary store + lock); regenerable, machine-local.
/cm.cache
/cm.lock
/cm
