# Export these variables in your shell (or load them with your own .env tool).
#
# Provider access is custom-endpoint only (scope decision 2026-10-08): there is
# no built-in provider catalog. Configure base URL + models in
# ~/.pi/agent/models.json and supply the key there, or export one of the
# recognized API-key variables below (they map to models.json provider ids;
# `pir auth` prints which ones are set).

# Agent behavior
PIR_TOOL_EXECUTION=parallel
PIR_MAX_PARALLEL_TOOLS=8
PIR_FAIL_FAST=false
PIR_ALLOW_PARALLEL_SIDE_EFFECTS=false
# PIR_SYSTEM_PROMPT_FILE=/path/to/system-prompt.md

# Script runner (`pir js`): heap cap in MiB; 0 or unset = no cap. It does not
# read PI_EXT_MEMORY_MB or extensionLimits.
# PIR_JS_MEMORY_MB=0

# Runtime / threading
# Main tokio runtime: worker threads (1-64; unset = one per core) and
# blocking-pool ceiling (1-512; unset = 2 per core, min 4, max 32).
# PIR_TOKIO_WORKERS=4
# PIR_TOKIO_MAX_BLOCKING=16
# `pir env-daemon`: file-op worker threads (1-64; unset = detected
# parallelism clamped to 2-8) and concurrent exec/watch/pty requests
# (1-256; default 32).
# PIR_ENV_DAEMON_WORKERS=4
# PIR_ENV_DAEMON_MAX_LONG_REQUESTS=32

# Extensions (QuickJS runtime)
# Agent directory for extension discovery; defaults to ~/.pi/agent.
# PIR_AGENT_DIR=
# Project-local .pi/extensions load only with explicit trust.
PIR_TRUST_PROJECT=0

# Logging
RUST_LOG=info

# Custom-endpoint API keys (recognized by `pir auth`; keep keys out of logs)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
NVIDIA_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=

# Server / client
PIR_SERVER_ADDRESS=127.0.0.1:4321
# PIR_SERVER_AUTH_TOKEN=
PIR_ALLOW_REMOTE_AGENT=false
PIR_ALLOW_REMOTE_BASH=false
# PIR_SERVER_MAX_CONNECTIONS=128
# PIR_SERVER_MAX_REQUEST_BODY_BYTES=1048576
# PIR_SERVER_MAX_CONNECTION_BODY_BYTES=67108864
# Session/subscription caps (1..=1000000) and the per-read idle timeout in
# seconds (1..=86400); malformed or out-of-range values keep the default.
# PIR_SERVER_MAX_SESSIONS=256
# PIR_SERVER_MAX_SUBSCRIPTIONS=64
# PIR_SERVER_IDLE_TIMEOUT_SECS=300

# TUI
# Raw terminal-input hook deferral backstop in ms (default 5000, capped at 60000).
# PIR_TUI_TERMINAL_INPUT_BUDGET_MS=5000

# Sessions (JSONL)
PIR_SESSION_DIR=./sessions
